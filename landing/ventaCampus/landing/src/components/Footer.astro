---
import Icon from "./Icon.astro";
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top-grid">
      <div class="footer-brand-col">
        <a href="#" class="footer-logo">
          <div class="logo-mark">
            <Icon name="shopping-bag" size={18} color="#FFFFFF" />
          </div>
          <span class="logo-text">Campus<span class="logo-accent">Venta</span></span>
        </a>
        <p class="footer-tagline">
          Transformando el comercio universitario dentro de la UTP Piura mediante tecnología en tiempo real, geolocalización por torre y piso, y contacto directo.
        </p>
        <div class="footer-utp-note">
          <div class="utp-dot"></div>
          <span>Comunidad Estudiantil UTP Piura • Ciclo 2026</span>
        </div>
      </div>

      <div class="footer-nav-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="#catalogo">Catálogo en Vivo</a></li>
          <li><a href="#radar">Radar por Pisos</a></li>
          <li><a href="#como-funciona">Cómo Funciona</a></li>
          <li><a href="#simulador">Modo Emprendedor</a></li>
          <li><a href="#beneficios">Pilares del Proyecto</a></li>
          <li><a href="#preguntas">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <div class="footer-nav-col">
        <h4 class="footer-heading">Categorías</h4>
        <ul class="footer-links">
          <li><a href="#catalogo">Postres & Dulces</a></li>
          <li><a href="#catalogo">Almuerzos & Snacks</a></li>
          <li><a href="#catalogo">Accesorios & Moda</a></li>
          <li><a href="#catalogo">Servicios Universitarios</a></li>
          <li><a href="#catalogo">Impresiones Express</a></li>
        </ul>
      </div>

      <div class="footer-nav-col">
        <h4 class="footer-heading">Campus</h4>
        <div class="campus-address-card">
          <Icon name="map-pin" size={18} color="var(--color-primary)" />
          <div class="addr-text">
            <strong>Campus UTP Piura</strong>
            <span>Av. Vice con Av. Sánchez Cerro</span>
            <small>Torre A, Torre B y Pabellón Central</small>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom-bar">
      <p class="copyright-text">
        &copy; 2026 CampusVenta. Desarrollado con dedicación para los emprendedores de la UTP Piura.
      </p>
      <div class="footer-badges">
        <span class="f-badge">0% Comisiones</span>
        <span class="f-badge">100% Estudiantil</span>
        <span class="f-badge">Hecho con Astro</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark);
    color: #FFFFFF;
    padding: 70px 0 90px; /* Padding extra abajo por el sticky bottom bar en móvil */
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .logo-mark {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--color-primary) 0%, #FF7A00 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
  }

  .logo-accent {
    color: var(--color-primary);
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #9BA3AF;
  }

  .footer-utp-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.775rem;
    font-weight: 700;
    color: #F87171;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .utp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #EF4444;
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 18px;
    letter-spacing: 0.02em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: #9BA3AF;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .campus-address-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px;
    border-radius: var(--radius-sm);
  }

  .addr-text {
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .addr-text strong {
    color: #FFFFFF;
    margin-bottom: 2px;
  }

  .addr-text span {
    color: #9BA3AF;
  }

  .addr-text small {
    color: #6B7280;
    margin-top: 4px;
  }

  .footer-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 16px;
  }

  .copyright-text {
    font-size: 0.8rem;
    color: #6B7280;
  }

  .footer-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .f-badge {
    font-size: 0.725rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.06);
    color: #9BA3AF;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 900px) {
    .footer-top-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
