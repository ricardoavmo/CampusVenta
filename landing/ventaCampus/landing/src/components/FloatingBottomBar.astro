---
import Icon from "./Icon.astro";
---

<!-- Sticky Bottom Bar conforme a la Sección 6.3 de desing.md -->
<div class="sticky-bottom-bar" id="floating-bar">
  <div class="bar-container">
    <div class="bar-left-col">
      <div class="count-circle">
        <span class="count-num">48</span>
      </div>
      <div class="bar-meta-text">
        <span class="bar-title">Emprendimientos en Campus</span>
        <span class="bar-subtitle">UTP Piura • Torres A, B y Patio</span>
      </div>
    </div>

    <div class="bar-right-col">
      <a href="#catalogo" class="bar-cta-btn">
        <span>Ver Catálogo</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</div>

<style>
  .sticky-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background-color: rgba(22, 24, 29, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-lg); /* 0px -4px 20px rgba(0, 0, 0, 0.06) */
    padding: 12px 20px;
    transition: transform 0.3s ease;
  }

  .bar-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .bar-left-col {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .count-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #FFFFFF;
    color: var(--color-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .bar-meta-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .bar-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .bar-subtitle {
    font-size: 0.725rem;
    color: #9BA3AF;
  }

  .bar-right-col {
    display: flex;
    align-items: center;
  }

  .bar-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-primary);
    color: #FFFFFF;
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: var(--shadow-primary);
    transition: all 0.2s ease;
  }

  .bar-cta-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .sticky-bottom-bar {
      padding: 10px 14px;
    }
    .bar-subtitle {
      display: none;
    }
    .bar-cta-btn {
      padding: 8px 14px;
      font-size: 0.8rem;
    }
  }
</style>
