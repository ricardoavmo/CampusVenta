          name: "Piso 1 — Recepción & Hall",
          sub: "0 emprendedores",
          online: false,
          zoneTip: "Acceso peatonal por Av. Vice y módulos de atención al estudiante.",
          vendors: []
        }
      ]
    },
    "patio": {
      title: "Patio & Cafetería — Radar en Vivo",
      count: "5 activos",
      floors: [
        {
          level: 2,
          name: "Nivel 2 — Graderías & Áreas Verdes",
          sub: "2 emprendedores en sombra",
          online: true,
          zoneTip: "Graderías norte bajo sombra de árboles del campus.",
          vendors: [
            {
              name: "Sticker Mania UTP",
              rating: "4.7",
              location: "Graderías norte cerca a biblioteca",
              desc: "Stickers impermeables para laptop y botellas térmicas.",
              price: "Desde S/ 1.50",
              icon: "sparkles"
            }
          ]
        },
        {
          level: 1,
          name: "Nivel 1 — Zona de Mesas Cafetería",
          sub: "3 emprendedores en receso",
          online: true,
          zoneTip: "Mesas compartidas de cafetería y pérgolas principales.",
          vendors: [
            {
              name: "Empanadas Don Lucho",
              rating: "4.9",
              location: "Mesa 8 cerca a pérgola central",
              desc: "Empanadas de carne y pollo recién horneadas con ají casero.",
              price: "Desde S/ 4.00",
              icon: "utensils"
            },
            {
              name: "Postres La Piuranita",
              rating: "4.9",
              location: "Bancas bajo la sombra de pérgola",
              desc: "Torta húmeda de chocolate en vasito y cheesecake de maracuyá.",
              price: "Desde S/ 5.00",
              icon: "cake"
            }
          ]
        }
      ]
    }
  };

  let currentTower = "torre-a";
  let currentFloor = 3;

  const towerBtns = document.querySelectorAll(".tower-btn");
  const towerTitle = document.getElementById("schematic-tower-name");
  const floorsContainer = document.getElementById("floors-container");
  const resultsTitle = document.getElementById("active-floor-title");
  const vendorPillCount = document.getElementById("active-vendor-pill-count");
  const contextFloorZone = document.getElementById("context-floor-zone");
  const contextFloorTip = document.getElementById("context-floor-tip");
  const vendorsContainer = document.getElementById("vendors-list-container");
  const elevatorCab = document.getElementById("svg-elevator-cab");
  const elevatorDisplay = document.getElementById("svg-elevator-floor-display");

  // Posiciones Y del elevador según el piso
  const elevatorPositions: Record<number, number> = {
    5: -136, // Piso 5 arriba
    4: -68,  // Piso 4
    3: 0,    // Piso 3 centro
    2: 68,   // Piso 2
    1: 136   // Piso 1 lobby
  };

  function updateSvgFloorHighlights(floorLevel: number) {
    const svgCards = document.querySelectorAll(".svg-floor-card");
    svgCards.forEach((card) => {
      const fl = Number(card.getAttribute("data-floor"));
      const isSelected = fl === floorLevel;

      const baseRect = card.querySelector(".floor-base-rect");
      const highlightRect = card.querySelector(".floor-highlight-rect");
      const scanBeam = card.querySelector(".floor-scan-beam");
      const levelPill = card.querySelector(".floor-level-pill");
      const levelLabel = card.querySelector(".floor-level-label");
      const titleLabel = card.querySelector(".floor-title-label");
      const beacon = card.querySelector(".floor-vendor-beacon");

      if (isSelected) {
        card.classList.add("active");
        if (baseRect) {
          baseRect.setAttribute("stroke", "#FF441F");
          baseRect.setAttribute("stroke-width", "2.8");
          baseRect.setAttribute("filter", "url(#activeNeonGlow)");
        }
        if (highlightRect) highlightRect.setAttribute("opacity", "1");
        if (scanBeam) {
          scanBeam.classList.add("active-scanning");
          scanBeam.setAttribute("opacity", "0.9");
        }
        if (levelPill) levelPill.setAttribute("fill", "#FF441F");
        if (levelLabel) levelLabel.setAttribute("fill", "#FFFFFF");
        if (titleLabel) {
          titleLabel.setAttribute("fill", "#FF441F");
          titleLabel.setAttribute("font-weight", "800");
        }
        if (beacon) beacon.classList.add("active");
      } else {
        card.classList.remove("active");
        if (baseRect) {
          baseRect.setAttribute("stroke", "#CBD5E1");
          baseRect.setAttribute("stroke-width", "1.5");
          baseRect.setAttribute("filter", "url(#cardSoftShadow)");
        }
        if (highlightRect) highlightRect.setAttribute("opacity", "0");
        if (scanBeam) {
          scanBeam.classList.remove("active-scanning");
          scanBeam.setAttribute("opacity", "0");
        }
        if (levelPill) levelPill.setAttribute("fill", "#F1F5F9");
        if (levelLabel) levelLabel.setAttribute("fill", "#1E293B");
        if (titleLabel) {
          titleLabel.setAttribute("fill", "#64748B");
          titleLabel.setAttribute("font-weight", "700");
        }
        if (beacon) beacon.classList.remove("active");
      }
    });

    // Mover cabina del ascensor suavemente y actualizar display LED
    if (elevatorCab && elevatorPositions[floorLevel] !== undefined) {
      elevatorCab.style.transform = `translate(0px, ${elevatorPositions[floorLevel]}px)`;
    }
    if (elevatorDisplay) {
      elevatorDisplay.textContent = `P${floorLevel}`;
    }
  }

  function renderRadar() {
    const data = radarData[currentTower];
    if (!data) return;

    if (towerTitle) towerTitle.textContent = data.title;

    // Renderizar Botones Rápidos de Piso
    if (floorsContainer) {
      floorsContainer.innerHTML = data.floors
        .map(
          (f) => `
        <button type="button" class="floor-row ${f.level === currentFloor ? "active" : ""}" data-floor="${f.level}" aria-label="Seleccionar ${f.name}">
          <div class="floor-level-badge">P${f.level}</div>
          <div class="floor-info">
            <span class="floor-name">${f.name}</span>
            <span class="floor-sub">${f.sub}</span>
          </div>
          <div class="floor-indicator">
            <span class="status-pulse-dot ${f.online ? "" : "offline"}"></span>
          </div>
        </button>
      `
        )
        .join("");

      floorsContainer.querySelectorAll(".floor-row").forEach((btn) => {
        btn.addEventListener("click", () => {
          const fl = Number(btn.getAttribute("data-floor"));
          currentFloor = fl;
          renderRadar();
        });
      });
    }

    // Actualizar estados visuales en el edificio SVG
    updateSvgFloorHighlights(currentFloor);

    // Conectar eventos click en los pisos del edificio SVG
    document.querySelectorAll(".svg-floor-card").forEach((card) => {
      card.addEventListener("click", () => {
        const fl = Number(card.getAttribute("data-floor"));
        if (!isNaN(fl)) {
          currentFloor = fl;
          renderRadar();
        }
      });
      card.addEventListener("keydown", (e: any) => {
        if (e.key === "Enter" || e.key === " ") {
          const fl = Number(card.getAttribute("data-floor"));
          if (!isNaN(fl)) {
            currentFloor = fl;
            renderRadar();
          }
        }
      });
    });

    // Renderizar detalles y lista de vendedores del piso seleccionado
    const selFloorObj = data.floors.find((f) => f.level === currentFloor) || data.floors[0];
    if (resultsTitle && selFloorObj) {
      const towerNameSimple =
        currentTower === "torre-a" ? "Torre A" : currentTower === "torre-b" ? "Torre B" : "Patio Central";
      resultsTitle.textContent = `${towerNameSimple} — Piso ${selFloorObj.level}`;
    }

    if (vendorPillCount && selFloorObj) {
      vendorPillCount.textContent = `${selFloorObj.vendors.length} emprendedor${selFloorObj.vendors.length === 1 ? "" : "es"} activo${selFloorObj.vendors.length === 1 ? "" : "s"}`;
    }

    if (contextFloorZone && selFloorObj) {
      contextFloorZone.textContent = selFloorObj.name;
    }

    if (contextFloorTip && selFloorObj) {
      contextFloorTip.textContent = selFloorObj.zoneTip;
    }

    if (vendorsContainer && selFloorObj) {
      if (selFloorObj.vendors.length === 0) {
        vendorsContainer.innerHTML = `
          <div style="text-align: center; padding: 36px 16px; background-color: var(--color-bg); border-radius: var(--radius-sm); border: 1px dashed var(--color-border);">
            <div style="margin-bottom: 6px; font-weight: 700; color: var(--color-dark); font-size: 0.95rem;">No hay vendedores en este piso en este momento</div>
            <p style="font-size: 0.825rem; color: var(--color-text-secondary); max-width: 320px; margin: 0 auto;">Prueba seleccionando otro piso en el edificio o activa tu alerta para enterarte cuando un estudiante suba a vender.</p>
          </div>
        `;
      } else {
        vendorsContainer.innerHTML = selFloorObj.vendors
          .map(
            (v) => `
          <article class="vendor-spotlight-item">
            <div class="spotlight-avatar-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><path d="m12 6 4 6h-8l4-6z"/>
              </svg>
            </div>
            <div class="spotlight-details">
              <div class="spotlight-top">
                <h4 class="spotlight-name">${v.name}</h4>
                <div class="spotlight-rating">
                  <span class="rating-num">${v.rating}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--color-rating)" stroke="none">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                </div>
              </div>
              <div class="spotlight-location-tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                <span>${v.location}</span>
              </div>
              <p class="spotlight-products">${v.desc}</p>
              <div class="spotlight-actions">
                <span class="spotlight-price-tag">${v.price}</span>
                <button type="button" class="btn btn-sm btn-primary open-chat-trigger" data-vendor="${v.name}" data-loc="${v.location}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                  </svg>
                  <span>Pedir por WhatsApp</span>
                </button>
              </div>
            </div>
          </article>
        `
          )
          .join("");

        // Conectar botones de WhatsApp al modal
        vendorsContainer.querySelectorAll(".open-chat-trigger").forEach((btn) => {
          btn.addEventListener("click", () => {
            const vName = btn.getAttribute("data-vendor") || "Emprendedor UTP";
            const vLoc = btn.getAttribute("data-loc") || "";
            const modal = document.getElementById("whatsapp-modal");
            if (modal) {
              modal.classList.add("is-visible");
              const titleElem = document.getElementById("modal-merchant-name");
              if (titleElem) titleElem.textContent = `${vName} (${vLoc})`;
              const itemInput = document.getElementById("modal-msg-preview") as HTMLTextAreaElement | null;
              if (itemInput) {
                itemInput.value = `¡Hola ${vName}! Vi tu publicación en CampusVenta UTP Piura. Estoy en ${vLoc} y me gustaría coordinar un pedido. ¿Tienes disponible ahora?`;
              }
            }
          });
        });
      }
    }
  }

  // Setup tower tabs
  towerBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      towerBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      currentTower = btn.getAttribute("data-tower") || "torre-a";
      currentFloor = currentTower === "patio" ? 1 : 3;
      renderRadar();
    });
  });

  // Init
  renderRadar();
</script>
