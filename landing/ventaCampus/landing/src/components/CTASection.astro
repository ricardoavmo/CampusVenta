---
import Icon from "./Icon.astro";
---

<section class="cta-banner-section" id="registro">
  <div class="container">
    <div class="cta-card-box">
      <div class="cta-decor-glow"></div>
      
      <div class="cta-inner-content">
        <div class="cta-tag">
          <Icon name="zap" size={14} color="#FF7A00" />
          <span>Únete al Movimiento Emprendedor</span>
        </div>

        <h2 class="cta-heading">
          Haz crecer tu emprendimiento dentro de la <span class="text-white-highlight">UTP Piura</span>
        </h2>

        <p class="cta-subheading">
          Más de 40 emprendedores ya formalizan su negocio y conectan con miles de estudiantes todos los días. Crea tu catálogo en minutos y empieza a vender sin comisiones.
        </p>

        <div class="cta-buttons-row">
          <a href="#simulador" class="btn btn-primary btn-lg cta-btn-main">
            <Icon name="shopping-bag" size={18} />
            <span>Registrar mi Emprendimiento</span>
          </a>
          <a href="#catalogo" class="btn btn-secondary btn-lg cta-btn-sub">
            <Icon name="search" size={18} />
            <span>Ver Catálogo Activo</span>
          </a>
        </div>

        <div class="cta-guarantees">
          <div class="guarantee-item">
            <Icon name="check-circle" size={16} color="var(--color-accent)" />
            <span>100% Gratis para alumnos UTP</span>
          </div>
          <div class="guarantee-item">
            <Icon name="check-circle" size={16} color="var(--color-accent)" />
            <span>Pagos directos por Yape / Plin</span>
          </div>
          <div class="guarantee-item">
            <Icon name="check-circle" size={16} color="var(--color-accent)" />
            <span>Control de horario y stock</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner-section {
    padding: 60px 0 90px;
    background-color: var(--color-bg);
  }

  .cta-card-box {
    background: linear-gradient(135deg, #16181D 0%, #202530 100%);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
    padding: 64px 32px;
    text-align: center;
  }

  .cta-decor-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 68, 31, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
  }

  .cta-heading {
    font-size: 2.75rem;
    line-height: 1.15;
    color: #FFFFFF;
    margin-bottom: 18px;
    letter-spacing: -0.025em;
  }

  .text-white-highlight {
    color: #FF5A36;
  }

  .cta-subheading {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #9BA3AF;
    margin-bottom: 36px;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .cta-btn-main {
    background-color: var(--color-primary) !important;
    color: #FFFFFF !important;
    text-decoration: none !important;
    box-shadow: 0px 8px 24px rgba(255, 68, 31, 0.5);
  }

  .cta-btn-main:hover {
    background-color: var(--color-primary-hover) !important;
  }

  .cta-btn-sub {
    background-color: rgba(255, 255, 255, 0.12) !important;
    color: #FFFFFF !important;
    text-decoration: none !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
  }

  .cta-btn-sub:hover {
    background-color: rgba(255, 255, 255, 0.22) !important;
    color: #FFFFFF !important;
  }

  .cta-guarantees {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.825rem;
    font-weight: 600;
    color: #E2E8F0;
  }

  @media (max-width: 640px) {
    .cta-card-box {
      padding: 44px 20px;
    }
    .cta-heading {
      font-size: 1.95rem;
    }
    .cta-guarantees {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>
