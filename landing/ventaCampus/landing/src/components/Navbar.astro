---
import Icon from "./Icon.astro";
---

<header class="navbar-header" id="navbar">
  <div class="container navbar-container">
    <a href="#" class="brand-logo" aria-label="CampusVenta Inicio">
      <div class="logo-mark">
        <Icon name="shopping-bag" size={20} color="#FFFFFF" />
      </div>
      <div class="logo-text-group">
        <span class="logo-name">Campus<span class="logo-accent">Venta</span></span>
        <span class="campus-badge">
          <span class="campus-dot"></span>
          UTP Piura
        </span>
      </div>
    </a>

    <!-- Menú de Navegación (Desktop y Drawer Móvil) -->
    <nav class="nav-links" id="nav-menu" aria-label="Navegación principal">
      <a href="#catalogo" class="nav-link">
        <Icon name="search" size={16} class="nav-link-icon mobile-only" />
        <span>Catálogo en Vivo</span>
      </a>
      <a href="#radar" class="nav-link">
        <Icon name="compass" size={16} class="nav-link-icon mobile-only" />
        <span>Radar Campus</span>
      </a>
      <a href="#como-funciona" class="nav-link">
        <Icon name="zap" size={16} class="nav-link-icon mobile-only" />
        <span>Cómo Funciona</span>
      </a>
      <a href="#simulador" class="nav-link">
        <Icon name="radio" size={16} class="nav-link-icon mobile-only" />
        <span>Modo Emprendedor</span>
      </a>
      <a href="#preguntas" class="nav-link">
        <Icon name="award" size={16} class="nav-link-icon mobile-only" />
        <span>Preguntas</span>
      </a>

      <!-- Botón de acción dentro del menú móvil -->
      <div class="mobile-drawer-cta">
        <a href="#simulador" class="btn btn-primary w-full mobile-cta-btn">
          <Icon name="zap" size={16} />
          <span>Vender en Campus</span>
        </a>
      </div>
    </nav>

    <!-- Acciones en Header (Desktop y Botón Hamburguesa Móvil) -->
    <div class="nav-actions">
      <a href="#catalogo" class="btn btn-secondary btn-sm nav-btn-explore">
        <Icon name="search" size={16} />
        <span>Explorar</span>
      </a>
      <a href="#simulador" class="btn btn-primary btn-sm nav-btn-cta">
        <Icon name="zap" size={16} />
        <span>Vender en Campus</span>
      </a>

      <!-- Botón Hamburguesa Accesible y Estilizado -->
      <button
        class="mobile-toggle"
        id="mobile-menu-btn"
        aria-label="Alternar menú de navegación"
        aria-expanded="false"
        type="button"
      >
        <span class="hamburger-bar bar-1"></span>
        <span class="hamburger-bar bar-2"></span>
        <span class="hamburger-bar bar-3"></span>
      </button>
    </div>
  </div>

  <!-- Overlay para cerrar el menú móvil al tocar afuera -->
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
</header>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 3px rgba(22, 24, 29, 0.05);
    transition: all 0.25s ease;
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 12px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--color-primary) 0%, #FF7A00 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0px 4px 12px rgba(255, 68, 31, 0.3);
    flex-shrink: 0;
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-dark);
    letter-spacing: -0.03em;
  }

  .logo-accent {
    color: var(--color-primary);
  }

  .campus-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-utp);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .campus-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-utp);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .mobile-only {
    display: none;
  }

  .mobile-drawer-cta {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Botón Hamburguesa */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .mobile-toggle:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-primary-border);
  }

  .hamburger-bar {
    display: block;
    width: 20px;
    height: 2.2px;
    background-color: var(--color-dark);
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Animación a 'X' cuando está abierto */
  .mobile-toggle.is-active .bar-1 {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle.is-active .bar-2 {
    opacity: 0;
    transform: translateX(6px);
  }

  .mobile-toggle.is-active .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-backdrop {
    display: none;
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(22, 24, 29, 0.4);
    backdrop-filter: blur(4px);
    z-index: 95;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .nav-backdrop.is-visible {
    display: block;
    opacity: 1;
  }

  /* ==========================================================================
     RESPONSIVIDAD DEL NAVBAR (MÓVIL & TABLET)
     ========================================================================== */
  @media (max-width: 960px) {
    .nav-btn-explore,
    .nav-btn-cta {
      display: none !important; /* Ocultar los botones de escritorio para dar espacio */
    }

    .mobile-toggle {
      display: flex !important; /* Mostrar el botón hamburguesa */
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background-color: #FFFFFF;
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      align-items: stretch;
      padding: 20px 20px 24px;
      gap: 12px;
      box-shadow: var(--shadow-lg);
      z-index: 100;
      transform: translateY(-10px);
      opacity: 0;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    }

    .nav-links.is-open {
      display: flex;
      transform: translateY(0);
      opacity: 1;
    }

    .nav-link {
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-size: 1rem;
      background-color: var(--color-bg);
      color: var(--color-dark);
      border: 1px solid var(--color-border);
    }

    .nav-link:hover {
      background-color: var(--color-primary-subtle);
      border-color: var(--color-primary-border);
      color: var(--color-primary);
    }

    .mobile-only {
      display: block;
    }

    .mobile-drawer-cta {
      display: block;
      margin-top: 8px;
      padding-top: 12px;
      border-top: 1px dashed var(--color-border);
    }

    .mobile-cta-btn {
      width: 100%;
      padding: 14px;
      font-size: 1rem;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .logo-name {
      font-size: 1.15rem;
    }

    .campus-badge {
      font-size: 0.65rem;
    }
  }
</style>

<script>
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const navMenu = document.getElementById("nav-menu");
  const backdrop = document.getElementById("nav-backdrop");

  function toggleMenu(open?: boolean) {
    if (!mobileBtn || !navMenu) return;
    const shouldOpen = open !== undefined ? open : !navMenu.classList.contains("is-open");

    mobileBtn.setAttribute("aria-expanded", String(shouldOpen));
    if (shouldOpen) {
      mobileBtn.classList.add("is-active");
      navMenu.classList.add("is-open");
      if (backdrop) backdrop.classList.add("is-visible");
      document.body.style.overflow = "hidden"; // Prevenir scroll de fondo
    } else {
      mobileBtn.classList.remove("is-active");
      navMenu.classList.remove("is-open");
      if (backdrop) backdrop.classList.remove("is-visible");
      document.body.style.overflow = "";
    }
  }

  mobileBtn?.addEventListener("click", () => toggleMenu());
  backdrop?.addEventListener("click", () => toggleMenu(false));

  // Cerrar al pulsar un enlace
  navMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => toggleMenu(false));
  });
</script>
