---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CampusVenta | El Comercio Estudiantil Inteligente de la UTP Piura",
  description = "Plataforma centralizada para descubrir emprendimientos estudiantiles en la UTP Piura. Catálogo digital en vivo, ubicación en tiempo real por Torre y Piso, y contacto directo sin intermediarios.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="CampusVenta, UTP Piura, emprendimientos universitarios, postres campus, comida universitaria, comercio estudiantil, feria universitaria Piura" />
    <meta name="author" content="CampusVenta Team" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CampusVenta UTP Piura" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
